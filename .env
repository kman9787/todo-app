IMAGE_NAME=$APP_NAME
# MySQL env variables
MYSQL_DATABASE=appdbdev
MYSQL_USER=appdbdev
MYSQL_PASSWORD=appdbdev
MYSQL_ROOT_PASSWORD=appdbdev
# Application env variables
DATABASE_HOST=mysqldb
DATABASE_SCHEMA=appdbdev
DATABASE_PORT=3306
DATABASE_OPTIONS='sslMode=PREFERRED&allowPublicKeyRetrieval=true'
DATABASE_USERNAME=appdbdev
DATABASE_PASSWORD=appdbdev